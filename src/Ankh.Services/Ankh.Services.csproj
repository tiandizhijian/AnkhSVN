<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>Ankh.Services.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1574,1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- PendingChangeText.Designer.cs uses ResourceManager base name "Ankh.Scc.PendingChangeText"
       (no .Services segment), so the resource must be embedded under that exact name.
       The SDK default would name it "Ankh.Services.Scc.PendingChangeText.resources"
       (RootNamespace is Ankh.Services), which the ResourceManager cannot find at
       runtime, raising MissingManifestResourceException. -->
  <ItemGroup>
    <EmbeddedResource Update="Scc\PendingChangeText.resx">
      <LogicalName>Ankh.Scc.PendingChangeText.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ankh.ExtensionPoints\Ankh.ExtensionPoints.csproj" />
    <ProjectReference Include="..\Ankh.Ids\Ankh.Ids.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpSvn" />
    <PackageReference Include="SharpSvn.UI" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>